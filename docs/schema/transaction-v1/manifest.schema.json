{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atacan/srcmv/main/docs/schema/transaction-v1/manifest.schema.json",
  "title": "srcmv transaction manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["transaction_version", "transaction_id", "workspace_identity", "plan_sha256", "inputs", "targets", "metadata_limitations"],
  "properties": {
    "transaction_version": { "const": 1 },
    "transaction_id": { "$ref": "#/$defs/transaction_id" },
    "workspace_identity": { "$ref": "#/$defs/identity" },
    "plan_sha256": { "$ref": "#/$defs/digest" },
    "inputs": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/input" } },
    "targets": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/target" } },
    "metadata_limitations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 128 } }
  },
  "$defs": {
    "transaction_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "inode"],
      "properties": {
        "device": { "type": "integer", "minimum": 0 },
        "inode": { "type": "integer", "minimum": 0 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "parent_identity", "existed", "file_identity", "sha256", "length", "link_count"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "parent_identity": { "$ref": "#/$defs/identity" },
        "existed": { "type": "boolean" },
        "file_identity": { "oneOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "sha256": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "length": { "type": ["integer", "null"], "minimum": 0 },
        "link_count": { "type": ["integer", "null"], "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "existed": { "const": true } } },
          "then": { "properties": { "file_identity": { "$ref": "#/$defs/identity" }, "sha256": { "$ref": "#/$defs/digest" }, "length": { "type": "integer" }, "link_count": { "type": "integer", "minimum": 1 } } },
          "else": { "properties": { "file_identity": { "type": "null" }, "sha256": { "type": "null" }, "length": { "type": "null" }, "link_count": { "type": "null" } } }
        }
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_index", "start", "end", "operation_index"],
      "properties": {
        "input_index": { "type": "integer", "minimum": 0 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "operation_index": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_index", "path", "parent_identity", "original_existed", "original_identity", "original_sha256", "original_length", "candidate_name", "backup_name", "candidate_sha256", "candidate_length", "metadata_policy", "new_file_mode", "segments"],
      "properties": {
        "target_index": { "type": "integer", "minimum": 0, "maximum": 99 },
        "path": { "$ref": "#/$defs/path" },
        "parent_identity": { "$ref": "#/$defs/identity" },
        "original_existed": { "type": "boolean" },
        "original_identity": { "oneOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "original_sha256": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "original_length": { "type": ["integer", "null"], "minimum": 0 },
        "candidate_name": { "type": "string", "pattern": "^candidate-[0-9]{8}$" },
        "backup_name": { "type": "string", "pattern": "^backup-[0-9]{8}$" },
        "candidate_sha256": { "$ref": "#/$defs/digest" },
        "candidate_length": { "type": "integer", "minimum": 0 },
        "metadata_policy": { "enum": ["preserve_existing_mode", "new_file_mode"] },
        "new_file_mode": { "type": ["integer", "null"], "minimum": 0, "maximum": 4095 },
        "segments": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/segment" } }
      },
      "allOf": [
        {
          "if": { "properties": { "original_existed": { "const": true } } },
          "then": {
            "properties": {
              "original_identity": { "$ref": "#/$defs/identity" },
              "original_sha256": { "$ref": "#/$defs/digest" },
              "original_length": { "type": "integer", "minimum": 0 },
              "metadata_policy": { "const": "preserve_existing_mode" },
              "new_file_mode": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "original_identity": { "type": "null" },
              "original_sha256": { "type": "null" },
              "original_length": { "type": "null" },
              "metadata_policy": { "const": "new_file_mode" },
              "new_file_mode": { "type": "integer", "minimum": 0, "maximum": 438 }
            }
          }
        }
      ]
    }
  }
}
