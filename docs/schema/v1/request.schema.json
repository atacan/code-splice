{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/atacan/srcmv/main/docs/schema/v1/request.schema.json",
  "title": "srcmv protocol v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "operations"],
  "properties": {
    "protocol_version": { "const": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "positive_u64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256_precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "sha256" },
        "value": { "$ref": "#/$defs/digest" }
      }
    },
    "must_not_exist_precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "must_not_exist" } }
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "start", "end"],
          "properties": {
            "kind": { "const": "lines" },
            "start": { "$ref": "#/$defs/positive_u64" },
            "end": { "$ref": "#/$defs/positive_u64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "start", "end"],
          "properties": {
            "kind": { "const": "bytes" },
            "start": { "$ref": "#/$defs/u64" },
            "end": { "$ref": "#/$defs/positive_u64" }
          }
        }
      ]
    },
    "anchor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "file_start" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "file_end" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "line"],
          "properties": {
            "kind": { "const": "before_line" },
            "line": { "$ref": "#/$defs/positive_u64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "line"],
          "properties": {
            "kind": { "const": "after_line" },
            "line": { "$ref": "#/$defs/positive_u64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "offset"],
          "properties": {
            "kind": { "const": "byte_offset" },
            "offset": { "$ref": "#/$defs/u64" }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "selector", "precondition"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "selector": { "$ref": "#/$defs/selector" },
        "precondition": { "$ref": "#/$defs/sha256_precondition" }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "anchor", "precondition"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "precondition": {
          "oneOf": [
            { "$ref": "#/$defs/sha256_precondition" },
            { "$ref": "#/$defs/must_not_exist_precondition" }
          ]
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source", "destination"],
          "properties": {
            "kind": { "const": "move" },
            "source": { "$ref": "#/$defs/source" },
            "destination": { "$ref": "#/$defs/destination" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source", "destination"],
          "properties": {
            "kind": { "const": "copy" },
            "source": { "$ref": "#/$defs/source" },
            "destination": { "$ref": "#/$defs/destination" }
          }
        }
      ]
    }
  }
}
